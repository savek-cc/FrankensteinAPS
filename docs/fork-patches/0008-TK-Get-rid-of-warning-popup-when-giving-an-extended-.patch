From e7de99043ab2b8c3f63586d74d04414b8467e027 Mon Sep 17 00:00:00 2001
From: Timm Korte <korte@korte-ing.de>
Date: Sat, 10 Jan 2026 15:20:54 +0100
Subject: [PATCH 08/14] TK: Get rid of warning popup when giving an extended
 Bolus

---
 .../aaps/plugins/main/general/actions/ActionsFragment.kt   | 7 +------
 ui/src/main/res/values/strings.xml                         | 1 +
 2 files changed, 2 insertions(+), 6 deletions(-)

diff --git a/plugins/main/src/main/kotlin/app/aaps/plugins/main/general/actions/ActionsFragment.kt b/plugins/main/src/main/kotlin/app/aaps/plugins/main/general/actions/ActionsFragment.kt
index 9722d743ba..6ca2e9d3e1 100644
--- a/plugins/main/src/main/kotlin/app/aaps/plugins/main/general/actions/ActionsFragment.kt
+++ b/plugins/main/src/main/kotlin/app/aaps/plugins/main/general/actions/ActionsFragment.kt
@@ -117,12 +117,7 @@ class ActionsFragment : DaggerFragment() {
         binding.extendedBolus.setOnClickListener {
             activity?.let { activity ->
                 protectionCheck.queryProtection(activity, ProtectionCheck.Protection.BOLUS, UIRunnable {
-                    OKDialog.showConfirmation(
-                        activity, rh.gs(app.aaps.core.ui.R.string.extended_bolus), rh.gs(R.string.ebstopsloop),
-                        {
-                            uiInteraction.runExtendedBolusDialog(childFragmentManager)
-                        }, null
-                    )
+                    uiInteraction.runExtendedBolusDialog(childFragmentManager)
                 })
             }
         }
diff --git a/ui/src/main/res/values/strings.xml b/ui/src/main/res/values/strings.xml
index aa6c43a43b..de29b818fe 100644
--- a/ui/src/main/res/values/strings.xml
+++ b/ui/src/main/res/values/strings.xml
@@ -85,6 +85,7 @@
     <string name="disconnectpumpfor30m">Disconnect pump for 30 min</string>
     <string name="disconnectpumpfor1h">Disconnect pump for 1 h</string>
     <string name="disconnectpumpfor2h">Disconnect pump for 2 h</string>
+    <string name="disconnectpumpfor3h">Disconnect pump for 3 h</string>
     <string name="disconnectpumpfor6h">Disconnect pump for 6 h</string>
     <string name="resume">Resume</string>
     <string name="reconnect">Reconnect Pump</string>
-- 
2.55.0

